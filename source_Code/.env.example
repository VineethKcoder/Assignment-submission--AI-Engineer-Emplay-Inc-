# ---- LLM (any OpenAI-compatible endpoint) ----
# Groq (default): https://console.groq.com
GROQ_API_KEY=your_groq_api_key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
LLM_TPM_LIMIT=8000            # Groq free tier tokens/min per model; 0 disables client-side budgeting

# OpenAI instead:
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_FALLBACK_MODELS=
# LLM_TPM_LIMIT=0

# Local Ollama (runs on the RTX 4050, no API key needed - any non-empty value works):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_FALLBACK_MODELS=
# LLM_TPM_LIMIT=0

# ---- Retrieval models (defaults are tuned for a CUDA GPU) ----
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
DEVICE=auto                   # auto | cuda | cpu
# Low-spec CPU machine:
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Misc ----
OCR_ENABLED=true
AGENT_MAX_RETRIES=2
AGENT_MAX_CONCURRENCY=4
VALIDATOR_USE_LLM=true
